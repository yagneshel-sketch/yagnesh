<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>css box model </title>
    <style>
        .box{
            width: 200px;
            height: 100px;
            padding: 20px;
            border: 5px solid black;
            margin: 30px;
            background-color: lightblue;
        }

    </style>
</head>
<body>
    <h2>css box model</h2>
    <div class="box">
        this is a box.
</div>
</body>
</html>
