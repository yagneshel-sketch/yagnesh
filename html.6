<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>css practical</title>
    <style>
        h1{
            color: blue;
        }
        .para{
            color: green;
            background-color: lightyellow;
            padding: 10px;
        }
        #special{
            color: red;
            background-color: lightblue;
            margin: 20px;
            padding: 15px;
        }

    </style>
</head>
<body>
    <h1>welcome to css</h1>
    <p class="para">this paragraph uses a class selector.</p>
    <p id="special>">this paragraph uses an id selector .</p>
</body>
</html>
